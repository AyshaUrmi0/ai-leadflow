DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Mandatory for production deployment (32+ character random secret key for JWT session signing)
SESSION_SECRET="change-this-to-a-secure-random-32-character-secret-key"

# Optional email for initial admin seed (defaults to admin@novadental.com)
ADMIN_INITIAL_EMAIL="admin@novadental.com"

# Password for running initial admin database seed (prisma/seed.ts)
ADMIN_INITIAL_PASSWORD="SecureAdminPassword123!"

# Optional email for initial user seed (defaults to user@novadental.com)
USER_INITIAL_EMAIL="user@novadental.com"

# Password for running initial user database seed (prisma/seed.ts)
USER_INITIAL_PASSWORD="DemoUserPassword123!"

# Optional: AI Lead Intelligence Provider (Phase 10.4+)
# Must remain server-side only. Never use a NEXT_PUBLIC_ prefix.
GEMINI_API_KEY=""

# Google OAuth 2.0 (Phase 11: Single Sign-On / Google Sign-In)
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional application URL override (defaults to request host/origin or http://localhost:3000)
# APP_URL="http://localhost:3000"

